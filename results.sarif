{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "reporeaver",
          "version": "0.2.0",
          "informationUri": "https://github.com/reporeaver/reporeaver",
          "rules": [
            {
              "id": "RR-BEHAVIORAL_NETWORK",
              "name": "behavioral_network",
              "shortDescription": {
                "text": "Network communication \u2014 may phone home or download payloads detected"
              },
              "fullDescription": {
                "text": "Pattern 'network_behavior': ping\n            s"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://reporeaver.dev/rules/behavioral_network",
              "properties": {
                "severity": "medium",
                "confidence": "medium",
                "attack_path": "Code executes -> Network communication \u2014 may phone home or download payloads -> compromise",
                "remediation": "Review this code. If legitimate, ensure proper isolation and access controls."
              }
            },
            {
              "id": "RR-BEHAVIORAL_PERSISTENCE",
              "name": "behavioral_persistence",
              "shortDescription": {
                "text": "Persistence mechanism \u2014 writes to disk or installs auto-start detected"
              },
              "fullDescription": {
                "text": "Pattern 'persistence_behavior': chmod +"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://reporeaver.dev/rules/behavioral_persistence",
              "properties": {
                "severity": "medium",
                "confidence": "medium",
                "attack_path": "Code executes -> Persistence mechanism \u2014 writes to disk or installs auto-start -> compromise",
                "remediation": "Review this code. If legitimate, ensure proper isolation and access controls."
              }
            },
            {
              "id": "RR-SVG_XXE",
              "name": "svg_xxe",
              "shortDescription": {
                "text": "SVG contains XML External Entity (XXE) declaration"
              },
              "fullDescription": {
                "text": "XXE can read local files, perform SSRF, or enable DoS attacks. Attackers use this to exfiltrate environment files or cloud metadata."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://reporeaver.dev/rules/svg_xxe",
              "properties": {
                "severity": "critical",
                "confidence": "high",
                "attack_path": "SVG parsing -> XXE expansion -> file read / SSRF -> data exfiltration",
                "remediation": "Remove DOCTYPE and ENTITY declarations. Use a parser with XXE disabled."
              }
            },
            {
              "id": "RR-OBFUSCATED_SCRIPT",
              "name": "obfuscated_script",
              "shortDescription": {
                "text": "SVG <script> contains obfuscated JavaScript"
              },
              "fullDescription": {
                "text": "The script block uses encoding, hex escapes, or other obfuscation techniques to hide its true behavior from code review."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://reporeaver.dev/rules/obfuscated_script",
              "properties": {
                "severity": "high",
                "confidence": "high",
                "attack_path": "SVG rendered/built -> script executes -> contacts C2 -> downloads payload",
                "remediation": "Remove the <script> element entirely. SVGs should not contain scripts."
              }
            },
            {
              "id": "RR-SUSPICIOUS_JS_API",
              "name": "suspicious_js_api",
              "shortDescription": {
                "text": "SVG script uses 'eval(' \u2014 arbitrary code execution risk"
              },
              "fullDescription": {
                "text": "The JavaScript function 'eval(' can evaluate or execute arbitrary strings as code, enabling remote code execution."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://reporeaver.dev/rules/suspicious_js_api",
              "properties": {
                "severity": "critical",
                "confidence": "high",
                "attack_path": "SVG script -> eval/exec -> arbitrary code execution",
                "remediation": "Remove script usage of eval(. Use safer alternatives."
              }
            },
            {
              "id": "RR-RUNTIME_NETWORK_CALL",
              "name": "runtime_network_call",
              "shortDescription": {
                "text": "SVG script makes network request to external URL"
              },
              "fullDescription": {
                "text": "Script contacts 'https://phishing.example.com/login' \u2014 possible C2 callback or payload download."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://reporeaver.dev/rules/runtime_network_call",
              "properties": {
                "severity": "high",
                "confidence": "medium",
                "attack_path": "SVG script -> HTTP request -> attacker server -> payload retrieval",
                "remediation": "Remove network calls from SVGs. No SVG needs to phone home."
              }
            },
            {
              "id": "RR-SVG_EVENT_HANDLER",
              "name": "svg_event_handler",
              "shortDescription": {
                "text": "SVG inline event handler 'onload' executes JavaScript"
              },
              "fullDescription": {
                "text": "Event handler 'onload' can fire automatically when the SVG is rendered or parsed. It contains: eval(atob("
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://reporeaver.dev/rules/svg_event_handler",
              "properties": {
                "severity": "high",
                "confidence": "high",
                "attack_path": "SVG rendered -> onload fires -> JS executes -> malicious action",
                "remediation": "Remove inline event handlers. SVGs should not contain executable content."
              }
            },
            {
              "id": "RR-SVG_FOREIGN_OBJECT",
              "name": "svg_foreign_object",
              "shortDescription": {
                "text": "SVG <foreignObject> contains executable HTML/JS"
              },
              "fullDescription": {
                "text": "The foreignObject element can embed HTML that executes JavaScript. Attackers use this to bypass SVG-only scanners."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://reporeaver.dev/rules/svg_foreign_object",
              "properties": {
                "severity": "high",
                "confidence": "medium",
                "attack_path": "SVG rendered -> foreignObject parsed -> embedded script executes",
                "remediation": "Remove <foreignObject> elements or sanitize their contents."
              }
            },
            {
              "id": "RR-OBFUSCATION_ENCODING",
              "name": "obfuscation_encoding",
              "shortDescription": {
                "text": "Obfuscated/encoded string found in SVG outside <script> tags"
              },
              "fullDescription": {
                "text": "Line contains obfuscation indicators: var _0x4b8c=[\"\\x68\\x74\\x74\\x70\\x73\\x3A\\x2F\\x2F\\x63\\x32\\x2D\\x73\\x65\\x72\\x76\\x65\\x72\\x2E\\x65\\x76\\x69\\x6C\\x2E\\x63\\x6F\\x6D\\x2F\\x62\\x65\\x61\\x63\\x6F\\x6E\",\"\\x6F\\x70\\x65\\x6E\",\"\\x73\\x65\\x6E\\x64\"];"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://reporeaver.dev/rules/obfuscation_encoding",
              "properties": {
                "severity": "high",
                "confidence": "medium",
                "attack_path": "Build tooling or parser may process this content unsafely",
                "remediation": "Review and remove obfuscated content from SVGs."
              }
            },
            {
              "id": "RR-C2_CALLBACK",
              "name": "c2_callback",
              "shortDescription": {
                "text": "Suspicious external URL detected"
              },
              "fullDescription": {
                "text": "URL contains 'exfil'; URL contains 'collect'"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://reporeaver.dev/rules/c2_callback",
              "properties": {
                "severity": "high",
                "confidence": "medium",
                "attack_path": "File references https://exfil.example.com/collect -> network request to attacker-controlled server -> data exfiltration / payload download",
                "remediation": "Remove or replace the URL. Verify it is necessary and uses a trusted service."
              }
            },
            {
              "id": "RR-BEHAVIORAL_EXEC",
              "name": "behavioral_exec",
              "shortDescription": {
                "text": "Code execution \u2014 runs commands or evaluates strings as code detected"
              },
              "fullDescription": {
                "text": "Pattern 'execution_behavior': child_process"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://reporeaver.dev/rules/behavioral_exec",
              "properties": {
                "severity": "critical",
                "confidence": "medium",
                "attack_path": "Code executes -> Code execution \u2014 runs commands or evaluates strings as code -> compromise",
                "remediation": "Review this code. If legitimate, ensure proper isolation and access controls."
              }
            },
            {
              "id": "RR-ZERO_WIDTH_CHAR",
              "name": "zero_width_char",
              "shortDescription": {
                "text": "Zero-width/invisible Unicode character: U+200B ZERO WIDTH SPACE"
              },
              "fullDescription": {
                "text": "Invisible characters can alter code behavior without being visible in editors. Used for obfuscation and hidden control flow."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://reporeaver.dev/rules/zero_width_char",
              "properties": {
                "severity": "medium",
                "confidence": "high",
                "attack_path": "Source appears benign -> invisible chars alter logic -> hidden behavior",
                "remediation": "Remove invisible Unicode characters. Use a linter or 'cat -A' to reveal them."
              }
            },
            {
              "id": "RR-HOMOGLYPH",
              "name": "homoglyph",
              "shortDescription": {
                "text": "Homoglyph attack: 'eval' disguised with Cyrillic characters"
              },
              "fullDescription": {
                "text": "The identifier '\u0435val' uses Cyrillic characters that look identical to Latin 'eval' but are different code points. This can hide malicious imports or variable references."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://reporeaver.dev/rules/homoglyph",
              "properties": {
                "severity": "high",
                "confidence": "high",
                "attack_path": "Code reviewed as safe -> homoglyph binds to different function -> supply-chain attack",
                "remediation": "Replace homoglyph characters with their ASCII equivalents."
              }
            },
            {
              "id": "RR-POLICY_VIOLATION",
              "name": "policy_violation",
              "shortDescription": {
                "text": "Policy violation: blocked category"
              },
              "fullDescription": {
                "text": "Finding category 'c2_callback' is blocked by policy"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://reporeaver.dev/rules/policy_violation",
              "properties": {
                "severity": "critical",
                "confidence": "high",
                "attack_path": "File references https://exfil.example.com/collect -> network request to attacker-controlled server -> data exfiltration / payload download",
                "remediation": "Remove or quarantine the offending file"
              }
            }
          ]
        }
      },
